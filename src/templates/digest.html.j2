<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI News Daily</title>
</head>
<body style="margin:0;padding:20px 0;background-color:#f0f0f0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">

<div style="max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:4px;overflow:hidden;">

  <!-- Header -->
  <div style="background-color:#1a1a1a;padding:20px 28px;">
    <p style="margin:0;font-size:13px;font-weight:700;letter-spacing:0.1em;color:#ffffff;text-transform:uppercase;">
      AI News Daily &nbsp;&middot;&nbsp; {{ edition | upper }} &nbsp;&middot;&nbsp; {{ now }}
    </p>
  </div>

  <!-- Body -->
  <div style="padding:24px 28px;">

    {% if not stories %}
    <p style="color:#666666;font-size:14px;line-height:1.6;">
      No stories matched today. Try widening the time window or relaxing the
      relevance keywords in config/settings.yaml.
    </p>
    {% else %}

    {% for cat in seen_cats %}
    <div style="margin-bottom:28px;">

      <!-- Category header -->
      <p style="margin:0 0 14px 0;font-size:11px;font-weight:700;letter-spacing:0.12em;color:#888888;text-transform:uppercase;border-bottom:2px solid #eeeeee;padding-bottom:8px;">
        {{ cat | upper }}&nbsp;&nbsp;({{ by_category[cat] | length }})
      </p>

      {% for s in by_category[cat] %}
      <div style="margin-bottom:20px;padding-bottom:20px;{% if not loop.last %}border-bottom:1px solid #f4f4f4;{% endif %}">

        <!-- Title -->
        <p style="margin:0 0 4px 0;font-size:15px;font-weight:600;line-height:1.4;">
          <a href="{{ s.url }}" style="color:#1a56db;text-decoration:none;">{{ s.title }}</a>
        </p>

        <!-- Source · relative time -->
        <p style="margin:0 0 8px 0;font-size:12px;color:#888888;">
          {{ s.source_name }} &nbsp;&middot;&nbsp; {{ s.published_at | relative_time }}
        </p>

        <!-- Summary (treated as plain text — auto-escaped by Jinja2) -->
        {% if s.summary %}
        <p style="margin:0 0 8px 0;font-size:14px;color:#333333;line-height:1.6;">
          {{ s.summary }}
        </p>
        {% endif %}

        <!-- Link -->
        <p style="margin:0 0 4px 0;font-size:12px;">
          <a href="{{ s.url }}" style="color:#1a56db;word-break:break-all;">{{ s.url }}</a>
        </p>

        <!-- Also covered by -->
        {% if s.alt_sources %}
        <p style="margin:5px 0 0 0;font-size:12px;color:#888888;font-style:italic;">
          Also covered by: {{ s.alt_sources | join(' · ') }}
        </p>
        {% endif %}

      </div>
      {% endfor %}

    </div>
    {% endfor %}

    {% endif %}

  </div>

  <!-- Footer -->
  <div style="background-color:#f9f9f9;border-top:1px solid #eeeeee;padding:12px 28px;">
    <p style="margin:0;font-size:11px;color:#aaaaaa;">
      Scanned {{ total_scanned }} &nbsp;&middot;&nbsp; Kept {{ stories | length }} &nbsp;&middot;&nbsp; Dropped {{ total_scanned - (stories | length) }}
    </p>
  </div>

</div>
</body>
</html>
